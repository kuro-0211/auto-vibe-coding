flowchart LR
    subgraph HOST["WSL2 호스트 (Ubuntu 24.04)"]
        direction TB
        APP["🐍 ARIA 앱 컨테이너\nauto-vibe-coding-app-1\n(Reflex + LangGraph)"]:::app
        EXECUTOR["sandbox/executor.py\n────────────────\nclean_code() — 코드 블록 제거\nexecute_code() — Docker SDK 호출"]:::tool
        SOCK["/var/run/docker.sock\n(host mount)"]:::tool
        APP --> EXECUTOR --> SOCK
    end

    subgraph SB["🐳 Docker 샌드박스 (격리)"]
        direction TB
        RUN["auto-vibe-sandbox\npython -c <code>"]:::docker
        FS["임시 파일시스템\n(호스트 마운트 없음)\nremove=True"]:::slate
        NET["network_mode: none\n(외부 통신 차단)"]:::slate
        LIMIT["mem_limit / nano_cpus\n(config/sandbox.yaml)"]:::slate
        RUN --> FS
        RUN --> NET
        RUN --> LIMIT
    end

    PARSER["sandbox/error_parser.py\n────────────────\nformat_error_for_agent()\n에러 메시지 정제"]:::tool

    SOCK -- "Docker API" --> SB
    SB -- "stdout / stderr / exit code" --> EXECUTOR
    EXECUTOR -- "실패 시" --> PARSER
    PARSER -- "정제된 에러" --> APP

    classDef app    fill:#f8fafc,stroke:#94a3b8,color:#1e293b
    classDef tool   fill:#ede9fe,stroke:#c4b5fd,color:#3b0764
    classDef docker fill:#e0f2fe,stroke:#7dd3fc,color:#0c4a6e
    classDef slate  fill:#f1f5f9,stroke:#cbd5e1,color:#475569
