flowchart LR
    INPUT(["🧑 사용자 입력\n키워드 / 목적\n이메일 첨부 형식"]):::user

    subgraph PHASE1["■ Phase 1  (build_phase1_graph)"]
        direction LR

        subgraph RA["① Research Agent"]
            direction LR
            TAVILY["🔍 Tavily\n웹 검색 (max=5)"]:::tool
            GPT_R["🤖 GPT-5.4-mini\n(학교 API)\n검색 결과 정리"]:::gpt
            TAVILY --> GPT_R
        end

        DECIDE{"💡 code_decision\nGPT-5.4-mini\n코드 필요 판단"}:::decision

        subgraph CGEN["② Code Generation"]
            direction LR
            OLLAMA_G["🦙 Ollama qwen2.5-coder\n코드 생성"]:::ollama
        end

        subgraph CREV["③ Code Review"]
            direction LR
            OLLAMA_REV["🦙 Ollama qwen2.5-coder\n코드 리뷰"]:::ollama
        end

        subgraph HITL["④ Human-in-the-Loop"]
            direction LR
            EDITOR["✏️ 사용자 코드 편집\n(Reflex 편집창)"]:::user
            APPLY["human_review_node\nedited_code → code_result"]:::hitl
            EDITOR --> APPLY
        end
    end

    subgraph PHASE2["■ Phase 2  (build_phase2_graph)"]
        direction LR

        subgraph EXEC["⑤ Docker 샌드박스 실행"]
            direction LR
            DOCKER["🐳 auto-vibe-sandbox\n격리 / 60s / 1GB"]:::docker
        end

        subgraph SC["🔄 Self-Correction (≤3회)"]
            direction LR
            ERR["⚠️ 에러 감지"]:::error
            GEMMA_E["🦙 gemma3:4b\n에러 분석"]:::ollama
            OLLAMA_F["🦙 qwen2.5-coder\n코드 수정"]:::ollama
            LIMIT{"retry_count\n≥ 3 ?"}:::decision
            ERR --> GEMMA_E --> OLLAMA_F --> LIMIT
        end

        subgraph OA["⑥ Output Agent (v1.3.1)"]
            direction LR
            TMPL_O["📋 템플릿 조립\n(LLM 호출 없음)\nMarkdown"]:::tool
        end

        subgraph EXPORT["⑦ 파일 변환"]
            direction LR
            PDF["📄 PDF\nfpdf2 + NanumGothic"]:::file
            DOCX["📝 Word\npython-docx"]:::file
            MD["📋 Markdown"]:::file
        end

        subgraph EA["⑧ Email Agent (선택)"]
            direction LR
            EMAIL_CHECK{"send_email ?"}:::decision
            EMAIL_SEND["📧 네이버 SMTP\nsmtp.naver.com:465\n본문 + 첨부"]:::email
            EMAIL_CHECK -- "Yes" --> EMAIL_SEND
            EMAIL_CHECK -- "No" --> SKIP_EMAIL(["화면 출력만"]):::output
        end
    end

    OUTPUT(["📄 최종 결과물\n다운로드(PDF/Word/MD)\n+ 이메일 첨부"]):::output

    INPUT --> RA
    RA --> DECIDE
    DECIDE -- "needs_code = true" --> CGEN
    DECIDE -- "needs_code = false" --> OA
    CGEN --> CREV
    CREV --> HITL
    HITL -- "Phase 1 END\n(승인 시 Phase 2 시작)" --> EXEC
    DOCKER -- "✅ success" --> OA
    DOCKER -- "❌ fail" --> ERR
    LIMIT -- "No → 재시도" --> EXEC
    LIMIT -- "Yes → 실패 리포트" --> OA
    OA --> EXPORT
    EXPORT --> EA
    EMAIL_SEND --> OUTPUT
    SKIP_EMAIL --> OUTPUT

    classDef user      fill:#dbeafe,stroke:#93c5fd,color:#1e3a5f,font-weight:bold
    classDef gpt       fill:#dcfce7,stroke:#86efac,color:#14532d
    classDef ollama    fill:#fee2e2,stroke:#fca5a5,color:#7f1d1d
    classDef tool      fill:#ede9fe,stroke:#c4b5fd,color:#3b0764
    classDef docker    fill:#e0f2fe,stroke:#7dd3fc,color:#0c4a6e
    classDef error     fill:#fff1f2,stroke:#fda4af,color:#9f1239
    classDef decision  fill:#fef3c7,stroke:#fcd34d,color:#78350f
    classDef email     fill:#f0fdf4,stroke:#86efac,color:#14532d
    classDef output    fill:#d1fae5,stroke:#6ee7b7,color:#064e3b,font-weight:bold
    classDef file      fill:#fef9c3,stroke:#fde047,color:#713f12
    classDef hitl      fill:#fce7f3,stroke:#f9a8d4,color:#831843
